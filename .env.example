# Copy to .env and fill in the API keys (Settings > General > Security > API Key in each app).
SONARR_URL=http://media-server:8989
SONARR_QUALITY_PROFILE=HD-1080p
SONARR_API_KEY=

RADARR_URL=http://media-server:7878
RADARR_QUALITY_PROFILE=Low Quality 1080
RADARR_API_KEY=

LIDARR_URL=http://media-server:8686
# Empty = the root folder default (currently Lossless)
LIDARR_QUALITY_PROFILE=
LIDARR_API_KEY=

# Plex server for "Play In Plex" (token: the Plex Home admin / server owner)
PLEX_URL=http://<plex-server-ip>:32400
PLEX_TOKEN=
