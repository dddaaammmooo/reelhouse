<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/dddaaammmooo/reelhouse" version="1.1.0" viewmodes="maximized">
    <tizen:application id="MdLoader01.MediaLoader" package="MdLoader01" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Reelhouse</name>
    <description>Search and queue TV shows, movies and music via Sonarr, Radarr and Lidarr.</description>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <!-- Voice search: microphone access for speech recognition -->
    <tizen:privilege name="http://tizen.org/privilege/mediacapture"/>
    <tizen:privilege name="http://tizen.org/privilege/recorder"/>
    <tizen:privilege name="http://tizen.org/privilege/voicecontrol"/>
    <!-- Video player: the remote's play / pause / stop / rewind / fast-forward keys -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
